<div class="events-root">

  {# HERO CONTAINER #}
  <header class="marathon-hero-wrap" id="marathon-hero" aria-label="All Play No Work Marathon Header">
    <div class="marathon-hero-content">
      <div class="marathon-hero-brand-row">
        <div class="marathon-poster-frame">
          <img class="marathon-poster-img" src="/assets/apnw-c.png" alt="All Play No Work 12-Hour Improv Marathon emblem" width="130" height="130" loading="eager" fetchpriority="high">
        </div>
        <div class="marathon-hero-headings">
          <div class="marathon-status-tags" aria-label="Event edition">
            <span class="marathon-tag marathon-tag--edition">Second Edition · Completed 2nd Oct 2026</span>
            <span class="marathon-tag marathon-tag--highlight">12 Hours of Play</span>
          </div>
          <h1 class="marathon-hero-title">All Play No Work</h1>
          <p class="marathon-hero-sub">The 12-Hour Improvathon happened — and we will be back!</p>
        </div>
      </div>

      <div class="marathon-hero-timing" style="margin-top: 1rem;">
        <span class="timing-chip">Friday, 2nd October 2026</span>
        <span class="marathon-timing-sep" aria-hidden="true">·</span>
        <span class="timing-chip">2:00 PM – 2:00 AM</span>
        <span class="marathon-timing-sep" aria-hidden="true">·</span>
        <span class="timing-chip">Underline Center, Indiranagar</span>
      </div>

      <div class="marathon-hero-actions" style="margin-top: 1.25rem;">
        <a class="btn-apnw-primary" href="{{ marathon.upcoming.rsvpUrl }}" target="_blank" rel="noopener">Join WhatsApp for Next Edition ↗</a>
        <a class="btn-apnw-ghost" href="/fill-testimonial/?source=marathon">Leave a Testimonial ★</a>
      </div>
    </div>
  </header>

