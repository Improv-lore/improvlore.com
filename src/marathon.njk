---
layout: base.njk
permalink: /marathon/
canonicalUrl: /marathon/
pageStyles:
  - /assets/css/marathon.css
---

<div class="events-root">

  {# HERO CONTAINER #}
  <header class="marathon-hero-wrap" id="marathon-hero" aria-label="All Play No Work Marathon Header">
    <div class="marathon-hero-content">

      <div class="marathon-hero-split">

        {# LEFT: FESTIVAL INTRO #}
        <div class="marathon-hero-intro-col">
          <div class="marathon-hero-brand-row">
            <div class="marathon-poster-frame">
              <img class="marathon-poster-img" src="/assets/apnw-c.png" alt="All Play No Work 12-Hour Improv Marathon emblem" width="130" height="130" loading="eager" fetchpriority="high">
            </div>
            <div class="marathon-hero-headings">
              <div class="marathon-status-tags" aria-label="Event edition">
                <span class="marathon-tag marathon-tag--edition">{{ marathon.upcoming.edition }} · 2nd Oct</span>
              </div>
              <h1 class="marathon-hero-title">{{ marathon.upcoming.name }}</h1>
            </div>
          </div>

          <div class="marathon-hero-timing">
            <span class="timing-chip">{{ marathon.upcoming.dateFormatted }}</span>
            <span class="marathon-timing-sep" aria-hidden="true">·</span>
            <span class="timing-chip">{{ marathon.upcoming.timing }}</span>
            <span class="marathon-timing-sep" aria-hidden="true">·</span>
            <span class="timing-chip">{{ marathon.upcoming.venueShort }}</span>
          </div>

          <p class="marathon-hero-lede">
            Are you tired of staring at screens and rushing to meet deadlines? This Gandhi Jayanti, we're making the antidote: twelve straight hours of unscripted comedy, storytelling, live music, and late-night madness. All-Access and 4-Show Passes are now sold out—drop in for individual shows below.
          </p>

          <div class="marathon-hero-actions">
            <a class="btn-apnw-primary" href="#schedule">Single Show Tickets →</a>
            <a class="btn-apnw-ghost" href="#schedule">View Schedule ↓</a>
            <a class="marathon-hero-community" href="{{ marathon.upcoming.rsvpUrl }}" target="_blank" rel="noopener">WhatsApp Community ↗</a>
          </div>
        </div>

        {# RIGHT: 3-COLUMN EQUAL COUNTDOWN CANVAS (HOURS, MINUTES, SECONDS) #}
        <aside class="marathon-nonlinear-timer" id="hero-marathon-countdown" data-target="2026-10-02T14:00:00+05:30" aria-label="Countdown to festival kickoff">
          <div class="timer-mosaic-grid timer-mosaic-grid--triplet">
            {# HOURS BLOCK #}
            <div class="timer-block timer-block--hours">
              <div class="timer-block-top">
                <span class="timer-badge-pill">HOURS</span>
              </div>
              <div class="timer-block-main">
                <span class="timer-num" data-unit="hours">--</span>
              </div>
            </div>

            {# MINUTES BLOCK #}
            <div class="timer-block timer-block--minutes">
              <div class="timer-block-top">
                <span class="timer-badge-pill">MINUTES</span>
              </div>
              <div class="timer-block-main">
                <span class="timer-num" data-unit="minutes">--</span>
              </div>
            </div>

            {# SECONDS LIVE BLOCK #}
            <div class="timer-block timer-block--seconds">
              <div class="timer-block-top">
                <span class="timer-badge-pill timer-badge-pill--live">SECONDS</span>
              </div>
              <div class="timer-block-main">
                <span class="timer-num timer-num--pulse" data-unit="seconds">--</span>
              </div>
            </div>
          </div>

          {# QUICK PROJECTOR STRIP #}
          <div class="countdown-tools-strip">
            <button type="button" class="btn-stage-tool js-toggle-projector" title="Fullscreen Projector View (Shift+P)">
              ⛶ Projector View
            </button>
          </div>
        </aside>

      </div>

      <script src="/assets/marathon-live.js" defer></script>
    </div>
  </header>

  {# THE 12-HOUR OFFICIAL SCHEDULE #}
  <section class="page-section marathon-timeline-wrap" id="schedule" aria-labelledby="schedule-heading">
    <div class="marathon-schedule-intro">
      <h2 class="section-heading" id="schedule-heading">The Lineup (2 PM to 2 AM)</h2>
      <p class="section-sub">{{ marathon.upcoming.scheduleNote }}</p>
    </div>

    {# SCHEDULE CALLOUT / PASSES SOLD OUT NOTICE #}
    <div class="marathon-lineup-notice marathon-lineup-notice--soldout">
      <div class="marathon-lineup-notice-left">
        <span class="marathon-lineup-badge marathon-lineup-badge--soldout">Passes Sold Out</span>
        <h3 class="marathon-lineup-notice-title">All-Access &amp; 4-Show Passes are Sold Out.</h3>
        <p class="marathon-lineup-notice-desc">
          Full-festival passes have completely sold out! Single-show tickets are still available for individual show slots below.
        </p>
      </div>

      <div class="marathon-lineup-notice-ticket">
        <div class="marathon-ticket-preview-wrap marathon-ticket-preview-wrap--soldout" title="Passes sold out">
          <img class="marathon-ticket-preview-img" src="/assets/tickets/all-day-pass.png" alt="All-Day Pass ticket" width="280" height="105" loading="lazy">
          <span class="ticket-soldout-overlay-badge">SOLD OUT</span>
        </div>
      </div>

      <div class="marathon-lineup-notice-right">
        <div class="notice-soldout-cta">
          <span class="notice-soldout-tag">SOLD OUT</span>
          <a class="btn-apnw-primary" href="#schedule" style="margin-top: 0.4rem; font-size: 0.85rem; padding: 0.45rem 1rem;">Book Single Shows ↓</a>
        </div>
      </div>
    </div>

    {# CHRONOLOGICAL SCHEDULE LIST #}
    <div class="marathon-schedule-list" aria-label="Official marathon schedule timeline">
      {% for slot in marathon.upcoming.schedule %}
      <article class="marathon-schedule-card{% if slot.formatClass == 'latenight' %} marathon-schedule-card--latenight{% endif %}">

        {# TIME COLUMN #}
        <div class="marathon-schedule-time-col">
          <span class="marathon-schedule-time-main">{{ slot.time }}</span>
          <span class="marathon-schedule-time-end">until {{ slot.endTime }}</span>
          {% if slot.dateLabel %}
          <span class="marathon-schedule-date-badge">{{ slot.dateLabel }}</span>
          {% endif %}
          <div class="marathon-schedule-pill-wrap">
            <span class="marathon-format-pill pill-{{ slot.formatClass }}">{{ slot.format }}</span>
          </div>
        </div>

        {# POSTER COLUMN #}
        <div class="marathon-schedule-poster-col">
          {% if slot.isEitherOrJam %}
          <div class="marathon-either-or-posters">
            <span class="marathon-either-or-pill">Pick 1 of 2 Concurrent Jams</span>
            <a class="marathon-poster-link" href="/event/make-an-improv-song/" title="Make an Improv Song details">
              <img class="marathon-schedule-poster-img" src="/assets/posters/make-an-improv-song.jpg" alt="Make an Improv Song poster" loading="lazy" sizes="(min-width: 860px) 440px, 100vw">
            </a>
            <span class="marathon-either-or-mini-or">OR</span>
            <a class="marathon-poster-link" href="/event/make-friends-with-the-stage/" title="Make Friends with the Stage details">
              <img class="marathon-schedule-poster-img" src="/assets/posters/make-friends-with-the-stage.jpg" alt="Make Friends with the Stage poster" loading="lazy" sizes="(min-width: 860px) 440px, 100vw">
            </a>
          </div>
          {% elif slot.posterAfterDark %}
          <div class="marathon-poster-after-dark-wrap" data-after-dark-swap>
            <a class="marathon-poster-link" href="/event/{{ slot.slug }}/" title="{{ slot.title }} details">
              <div class="marathon-after-dark-stage">
                <img class="marathon-schedule-poster-img poster-day" src="{{ slot.poster }}" alt="{{ slot.title }} poster" loading="lazy" sizes="(min-width: 860px) 440px, 100vw">
                <img class="marathon-schedule-poster-img poster-night" src="{{ slot.posterAfterDark }}" alt="{{ slot.title }} After Dark poster" loading="lazy" sizes="(min-width: 860px) 440px, 100vw">
              </div>
            </a>
          </div>
          {% else %}
          <a class="marathon-poster-link" href="/event/{{ slot.slug }}/" title="{{ slot.title }} details">
            <img class="marathon-schedule-poster-img" src="{{ slot.poster }}" alt="{{ slot.title }} poster" loading="lazy" sizes="(min-width: 860px) 440px, 100vw">
          </a>
          {% endif %}
        </div>

        {# CONTENT BODY #}
        <div class="marathon-schedule-body">
          <span class="marathon-schedule-kicker">{{ slot.kicker }}</span>
          <h3 class="marathon-schedule-title">
            {% if slot.isEitherOrJam %}
            <span>Make an Improv Song <span class="title-or-accent">OR</span> Make Friends with the Stage</span>
            {% elif slot.formatClass == 'latenight' %}
            <span class="marathon-schedule-title-text"><a href="/event/{{ slot.slug }}/">The Silliest Show Tonight <span class="neon-text-afterdark">: After Dark</span></a></span>
            <a class="marathon-schedule-about-icon" href="/event/{{ slot.slug }}/" title="About {{ slot.title }}" aria-label="About {{ slot.title }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
                <path d="M140,180a12,12,0,1,1-12-12A12,12,0,0,1,140,180ZM128,72c-22.06,0-40,16.15-40,36v4a8,8,0,0,0,16,0v-4c0-11,10.77-20,24-20s24,9,24,20c0,13.88-11.83,21.36-19.89,26.47C124,139.63,120,143.43,120,152a8,8,0,0,0,16,0c0-3.32,1.87-5.59,6.71-8.67C152.06,137.4,168,127.24,168,108,168,88.15,150.06,72,128,72Zm100,56A100,100,0,1,1,128,28,100.11,100.11,0,0,1,228,128Zm-16,0a84,84,0,1,0-84,84A84.09,84.09,0,0,0,212,128Z"/>
              </svg>
            </a>
            {% else %}
            <span class="marathon-schedule-title-text"><a href="/event/{{ slot.slug }}/">{{ slot.title }}</a></span>
            <a class="marathon-schedule-about-icon" href="/event/{{ slot.slug }}/" title="About {{ slot.title }}" aria-label="About {{ slot.title }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
                <path d="M140,180a12,12,0,1,1-12-12A12,12,0,0,1,140,180ZM128,72c-22.06,0-40,16.15-40,36v4a8,8,0,0,0,16,0v-4c0-11,10.77-20,24-20s24,9,24,20c0,13.88-11.83,21.36-19.89,26.47C124,139.63,120,143.43,120,152a8,8,0,0,0,16,0c0-3.32,1.87-5.59,6.71-8.67C152.06,137.4,168,127.24,168,108,168,88.15,150.06,72,128,72Zm100,56A100,100,0,1,1,128,28,100.11,100.11,0,0,1,228,128Zm-16,0a84,84,0,1,0-84,84A84.09,84.09,0,0,0,212,128Z"/>
              </svg>
            </a>
            {% endif %}
          </h3>

          <p class="marathon-schedule-blurb">{{ slot.blurb }}</p>

          {% if slot.isEitherOrJam %}
          <div class="marathon-either-or-grid">
            {% for j in slot.jams %}
            <div class="marathon-either-or-option">
              <div class="marathon-either-or-opt-header">
                <span class="marathon-either-or-chip">{{ j.label }}</span>
                <h4 class="marathon-either-or-opt-title"><a href="/event/{{ j.slug }}/">{{ j.name }}</a></h4>
              </div>
              <p class="marathon-either-or-opt-desc">{{ j.desc }}</p>
              <div class="marathon-either-or-actions">
                {% if j.thumpnEventId %}
                  {% if marathon.upcoming.skipThumpnEmbed %}
                  <a class="marathon-either-or-btn marathon-either-or-btn--book" href="{{ 'https://thumpn.com/event/' + j.thumpnEventId + '/tickets'}}" target="_blank" rel="noopener">Book Tickets →</a>
                  {% else %}
                  <button type="button"
                          class="marathon-either-or-btn marathon-either-or-btn--book js-thumpn-modal-open"
                          data-event-id="{{ j.thumpnEventId }}"
                          data-embed-token="{{ j.thumpnEmbedToken }}"
                          data-event-title="{{ j.name }}">
                    Book Tickets →
                  </button>
                  {% endif %}
                {% elif j.districtUrl or j.ticketUrl %}
                  {% set targetUrl = j.districtUrl or j.ticketUrl %}
                  <a class="btn btn-primary marathon-either-or-btn"
                     {% if "district.in" in targetUrl %}data-ticket-slug{% endif %}
                     href="{{ targetUrl }}"
                     target="_blank"
                     rel="noopener">Buy Ticket</a>
                {% endif %}
              </div>
            </div>
            {% endfor %}
          </div>
          {% endif %}
        </div>

        {# TICKETS COLUMN #}
        {% if not slot.isEitherOrJam %}
        <div class="marathon-schedule-tickets-col">
          {% if slot.thumpnEventId %}
            {% if marathon.upcoming.skipThumpnEmbed %}
            <a class="marathon-schedule-book-btn" href="{{ 'https://thumpn.com/event/' + slot.thumpnEventId + '/tickets'}}" target="_blank" rel="noopener">Book Tickets →</a>
            {% else %}
            <button type="button"
                    class="marathon-schedule-book-btn js-thumpn-modal-open"
                    data-event-id="{{ slot.thumpnEventId }}"
                    data-embed-token="{{ slot.thumpnEmbedToken }}"
                    data-event-title="{{ slot.title }}">
              Book Tickets →
            </button>
            {% endif %}
          {% elif slot.districtUrl or slot.ticketUrl %}
            {% set targetUrl = slot.districtUrl or slot.ticketUrl %}
            <a class="btn btn-primary marathon-schedule-book-btn"
               {% if "district.in" in targetUrl %}data-ticket-slug{% endif %}
               href="{{ targetUrl }}"
               target="_blank"
               rel="noopener">Buy Ticket</a>
          {% else %}
            <a class="btn btn-primary marathon-schedule-book-btn" href="#passes">Get Passes / Tickets →</a>
          {% endif %}
        </div>
        {% endif %}


      </article>
      {% endfor %}
    </div>

  </section>

  {# PASSES & TICKETS #}
  <section class="page-section marathon-passes-wrap" id="passes" aria-labelledby="passes-heading">
    <h2 class="section-heading" id="passes-heading">Support Local Theatre: Passes &amp; Tickets</h2>
    <p class="section-sub">Every pass directly supports Improvlore and Underline Center and keeps independent, grassroots theatre alive in Bangalore.</p>

    <div class="marathon-passes-grid">
      {% for pass in marathon.upcoming.passes %}
      <div class="marathon-pass-card{% if pass.soldOut %} marathon-pass-card--soldout{% elif pass.featured or loop.first %} marathon-pass-card--featured{% endif %}">
        {% if pass.soldOut %}
        <span class="marathon-pass-badge marathon-pass-badge--soldout">SOLD OUT</span>
        {% elif pass.tag %}
        <span class="marathon-pass-badge">{{ pass.tag }}</span>
        {% endif %}

        {% if pass.id == "all-access" %}
        <div class="marathon-pass-card-ticket{% if pass.soldOut %} marathon-pass-card-ticket--soldout{% endif %}">
          <img src="/assets/tickets/all-day-pass.png" alt="All-Day Pass ticket graphic" width="340" height="128" class="marathon-pass-ticket-graphic" loading="lazy">
          {% if pass.soldOut %}
          <span class="ticket-soldout-overlay-badge">SOLD OUT</span>
          {% endif %}
        </div>
        {% elif pass.id == "four-show" %}
        <div class="marathon-pass-card-ticket{% if pass.soldOut %} marathon-pass-card-ticket--soldout{% endif %}">
          <img src="/assets/tickets/four-show-pass.png" alt="4-Show Pass ticket graphic" width="340" height="128" class="marathon-pass-ticket-graphic" loading="lazy">
          {% if pass.soldOut %}
          <span class="ticket-soldout-overlay-badge">SOLD OUT</span>
          {% endif %}
        </div>
        {% else %}
        <div class="marathon-pass-card-ticket marathon-pass-card-ticket--generic">
          <div class="marathon-single-stub-badge">
            <span class="stub-badge-icon" aria-hidden="true">🎟️</span>
            <span class="stub-badge-label">Individual Show Ticket</span>
            <span class="stub-badge-sub">Book per session below</span>
          </div>
        </div>
        {% endif %}

        <h3 class="marathon-pass-title">{{ pass.name }}</h3>
        <p class="marathon-pass-desc">{{ pass.desc }}</p>
        <ul class="marathon-pass-perks">
          {% for perk in pass.perks %}
          <li>{{ perk }}</li>
          {% endfor %}
        </ul>
        <div class="event-buttons">
          {% if pass.soldOut %}
          <div class="pass-soldout-wrap">
            <span class="btn-apnw-soldout" aria-disabled="true">Sold Out</span>
            <span class="pass-soldout-sub">Single show tickets available above</span>
          </div>
          {% elif pass.razorpay %}
          <form class="razorpay-embed-container"><script src="https://checkout.razorpay.com/v1/payment-button.js" data-payment_button_id="pl_TeIUwNFDKT5gPL" async> </script> </form>
          {% else %}
          <a class="btn-apnw-primary" href="#schedule">Browse Sessions ↑</a>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </section>

  {# COMMON QUESTIONS #}
  <section class="page-section marathon-faq-wrap" aria-labelledby="faq-heading">
    <h2 class="section-heading" id="faq-heading">Common Questions</h2>
    <p class="section-sub">Everything you might wonder about dropping by for the marathon.</p>

    <div class="marathon-faq-grid">
      {% for item in marathon.upcoming.faqs %}
      <div class="marathon-faq-card">
        <h3>{{ item.q }}</h3>
        <p>{{ item.a }}</p>
      </div>
      {% endfor %}
    </div>
  </section>

  {# VENUE & FOOD PARTNERS #}
  <section class="page-section marathon-venue-partners-wrap" aria-labelledby="venue-heading">
    <div class="marathon-section-intro">
      <h2 class="section-heading" id="venue-heading">The Venue &amp; Food Partners</h2>
      <p class="section-sub">Where we're playing and what we're snacking on all day long.</p>
    </div>

    <div class="marathon-venue-partners-grid">

      {# LEFT COLUMN: VENUE CARD #}
      <div class="marathon-loc-card marathon-loc-card--venue">
        <div class="marathon-loc-card-body">
          <div class="marathon-loc-top-row">
            <div class="marathon-loc-badge-wrap">
              <span class="marathon-loc-badge">Festival Venue</span>
            </div>
            <div class="marathon-venue-logo-wrap">
              <img class="marathon-loc-venue-logo"
                   src="/assets/underline-logo.png"
                   alt="Underline Center"
                   width="170"
                   height="45"
                   loading="lazy">
            </div>
          </div>

          <h3 class="marathon-loc-title">{{ marathon.upcoming.venue }}</h3>
          <p class="marathon-loc-desc">
            A cozy community space tucked away in Indiranagar. Warm, welcoming, and a 10-minute walk from Indiranagar Metro Station.
          </p>

          <ul class="marathon-loc-perks" aria-label="Venue highlights">
            <li class="marathon-loc-perk">
              <span class="marathon-loc-perk-icon" aria-hidden="true">🚇</span>
              <span class="marathon-loc-perk-text">10-min walk from Indiranagar Metro</span>
            </li>
            <li class="marathon-loc-perk">
              <span class="marathon-loc-perk-icon" aria-hidden="true">❄️</span>
              <span class="marathon-loc-perk-text">Indoor AC Performance Stage</span>
            </li>
            <li class="marathon-loc-perk">
              <span class="marathon-loc-perk-icon" aria-hidden="true">🌿</span>
              <span class="marathon-loc-perk-text">Open Terrace F&amp;B &amp; Chill Zone</span>
            </li>
          </ul>
        </div>

        <div class="marathon-loc-card-footer">
          <a class="btn btn-primary marathon-loc-btn" href="{{ marathon.upcoming.venueMapsUrl }}" target="_blank" rel="noopener">
            Open in Google Maps ↗
          </a>
        </div>
      </div>

      {# RIGHT COLUMN: FOOD & BEVERAGE PARTNERS #}
      <div class="marathon-loc-card marathon-loc-card--partners">
        <div class="marathon-loc-card-body">
          <div class="marathon-loc-badge-wrap">
            <span class="marathon-loc-badge marathon-loc-badge--fnb">Food &amp; Beverage</span>
          </div>
          <h3 class="marathon-loc-title">Fuel on the Terrace</h3>
          <p class="marathon-loc-desc">
            Twelve hours of unscripted improv needs serious fuel. 
          </p>

          <div class="marathon-partners-list">
            {% for partner in marathon.upcoming.foodPartners %}
            <div class="marathon-partner-item">
              <div class="marathon-partner-logo-frame" style="--partner-bg: {{ partner.bgColor }};">
                <img class="marathon-partner-logo-img"
                     src="{{ partner.logo }}"
                     alt="{{ partner.alt }}"
                     width="80"
                     height="80"
                     loading="lazy">
              </div>
              <div class="marathon-partner-info">
                <div class="marathon-partner-header-row">
                  <h4 class="marathon-partner-name">{{ partner.brand or partner.name }}</h4>
                  <span class="marathon-partner-tag">{{ partner.category }}</span>
                </div>
                <p class="marathon-partner-tagline">{{ partner.tagline }}</p>

                {% if partner.menuHighlights %}
                <div class="marathon-partner-menu-wrap">
                  <span class="marathon-partner-menu-label">Pop-Up Menu:</span>
                  <div class="marathon-partner-menu-tags">
                    {% for dish in partner.menuHighlights %}
                    <span class="marathon-partner-dish-tag">{{ dish }}</span>
                    {% endfor %}
                  </div>
                </div>
                {% endif %}

                {% if partner.note %}
                <p class="marathon-partner-note">{{ partner.note }}</p>
                {% endif %}

                <div class="marathon-partner-action">
                  <a class="marathon-partner-insta-link"
                     href="{{ partner.instagramUrl }}"
                     target="_blank"
                     rel="noopener"
                     aria-label="Visit {{ partner.name }} on Instagram (opens in new tab)">
                    <svg class="marathon-partner-insta-svg" fill="currentColor" role="img" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
