---
layout: base.njk
pagination:
  data: catalog
  size: 1
  alias: fmt
  addAllPagesToCollections: true
permalink: "{{ filters.formatPermalink(fmt) }}index.html"
pageStyles:
  - /assets/css/event-detail.css
---

{% set bodyText = fmt.fullText or fmt.next.full_content or fmt.blurb %}
{% set d = {
  type: fmt.type,
  slug: fmt.slug,
  image: fmt.image,
  title: fmt.title,
  hasWhen: fmt.hasUpcoming,
  startsRaw: fmt.startsAt,
  startsAt: filters.formatDateFull(fmt.startsAt),
  timeRange: filters.formatTimeRange(fmt.startsAt, fmt.endsAt),
  venue: fmt.venue,
  price: fmt.price,
  sessions: fmt.sessions,
  badges: fmt.badges,
  emptyMeta: not fmt.hasUpcoming,
  bodyParas: filters.bodyParagraphs(bodyText),
  ticketUrl: fmt.ticketUrl,
  isMarathon: fmt.isMarathon,
  thumpnUrl: fmt.thumpnUrl,
  districtUrl: fmt.districtUrl,
  notify: not fmt.hasUpcoming,
  learnMore: fmt.next.learn_more
} %}

{% include "event-detail.njk" %}
