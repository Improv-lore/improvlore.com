---
layout: base.njk
title: "Scan & Connect – QR Codes | Improvlore"
pageDescription: "Official Improvlore QR codes: Instagram, WhatsApp Community, and Upcoming Show Tickets."
permalink: /qr/index.html
canonicalUrl: /qr/
pageStyles:
  - "/assets/css/qr.css"
---

<div class="qr-page-root">

  {# MINIMAL HERO HEADER #}
  <header class="qr-hero">
    <div class="qr-hero-inner">
      <h1 class="qr-hero-title">Scan &amp; Connect</h1>
      <button type="button" class="qr-projector-btn js-open-projector" data-target="instagram" title="Fullscreen Projector View (Shift+P)">
        ⛶ Projector View
      </button>
    </div>
  </header>

  {# 3 CLEAN QR CARDS: TITLE + QR + LINK #}
  <main class="qr-grid">

    {# 1. INSTAGRAM #}
    <article class="qr-card qr-card--instagram js-qr-card" data-id="instagram" data-title="Instagram" data-sub="@improvlore" data-url="https://instagram.com/improvlore">
      <div class="qr-card-top">
        <span class="qr-card-dot"></span>
        <h2 class="qr-card-title">Instagram</h2>
      </div>

      <div class="qr-frame js-trigger-projector" data-target="instagram" title="Click to open in Projector View">
        <div class="qr-box">
          {{ qrcodes.items[0].svg | safe }}
        </div>
      </div>

      <a href="https://instagram.com/improvlore" class="qr-card-link" target="_blank" rel="noopener">
        @improvlore →
      </a>
    </article>

    {# 2. WHATSAPP COMMUNITY #}
    <article class="qr-card qr-card--whatsapp js-qr-card" data-id="whatsapp" data-title="WhatsApp Community" data-sub="" data-url="{{ social.whatsapp }}">
      <div class="qr-card-top">
        <span class="qr-card-dot"></span>
        <h2 class="qr-card-title">WhatsApp Community</h2>
      </div>

      <div class="qr-frame js-trigger-projector" data-target="whatsapp" title="Click to open in Projector View">
        <div class="qr-box">
          {{ qrcodes.items[1].svg | safe }}
        </div>
      </div>

      <a href="{{ social.whatsapp }}" class="qr-card-link" target="_blank" rel="noopener">
        Join Community →
      </a>
    </article>

    {# 3. UPCOMING TICKETS #}
    <article class="qr-card qr-card--tickets js-qr-card" data-id="tickets" data-title="Upcoming Tickets" data-sub="Shows, Jams &amp; Workshops" data-url="https://improvlore.com/events/">
      <div class="qr-card-top">
        <span class="qr-card-dot"></span>
        <h2 class="qr-card-title">Upcoming Tickets</h2>
      </div>

      <div class="qr-frame js-trigger-projector" data-target="tickets" title="Click to open in Projector View">
        <div class="qr-box">
          {{ qrcodes.items[2].svg | safe }}
        </div>
      </div>

      <a href="https://improvlore.com/events/" class="qr-card-link" target="_blank" rel="noopener">
        Browse Shows &amp; Tickets →
      </a>
    </article>

  </main>

</div>

{# STAGE / PROJECTOR FULLSCREEN MODAL #}
<div id="qr-stage-modal" class="qr-stage-modal" role="dialog" aria-modal="true" aria-labelledby="js-stage-title" hidden>
  <div class="qr-stage-card">
    <button type="button" id="js-stage-close" class="qr-stage-close-btn" aria-label="Close projector view">×</button>

    <span class="qr-stage-brand">IMPROVLORE BANGALORE</span>
    <h2 id="js-stage-title" class="qr-stage-title">Instagram</h2>
    <p id="js-stage-sub" class="qr-stage-sub">@improvlore</p>

    <div class="qr-stage-qr-box" id="js-stage-qr">
      <!-- Injected SVG -->
    </div>

    <div class="qr-stage-instructions">
      📸 Point camera to scan
    </div>

    <div class="qr-stage-nav">
      <button type="button" class="qr-stage-nav-btn js-stage-nav-btn is-active" data-stage-target="instagram">1 · Instagram</button>
      <button type="button" class="qr-stage-nav-btn js-stage-nav-btn" data-stage-target="whatsapp">2 · WhatsApp</button>
      <button type="button" class="qr-stage-nav-btn js-stage-nav-btn" data-stage-target="tickets">3 · Tickets</button>
    </div>
  </div>
</div>

<script src="/assets/qr.js" defer></script>
