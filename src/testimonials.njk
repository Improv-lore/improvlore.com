---
layout: base.njk
title: Testimonials - Improvlore
permalink: /testimonials/
pageDescription: What performers, students, and audiences say about doing improv with Improvlore in Bangalore.
eleventyExcludeFromCollections: true
robots: noindex
pageStyles:
  - /assets/css/testimonials.css
---
{#
  Testimonials wall. Data comes from src/_data/testimonials.json, which is
  filled from the external collection form (see /fill-testimonial/). This page
  is deliberately unlinked from nav/footer for now and kept out of the sitemap
  (eleventyExcludeFromCollections) and search (robots: noindex) — share the
  direct link only.

  Each item: name, subtitle (the credit / relation-to-improvlore line),
  social (a handle, with or without a leading @), story (the quote). A social
  handle links to Instagram; leave it "" to omit. Set cast: "yes" to group a
  testimonial under "From our cast".

  `story` may be a single string, or a list of strings for multiple paragraphs:
    "story": ["First paragraph.", "Second paragraph."]
#}

<div class="events-root">
  <section class="page-section" aria-labelledby="section-testimonials">
    <h1 class="section-heading" id="section-testimonials">In Their Words</h1>
    <p class="section-sub">The people who jam, perform, and learn with us, on what it's been like.</p>

    <div class="photo-strip" style="margin: 1.4rem 0 1.8rem;">
      <figure class="polaroid-card" style="max-width: 440px; margin: 0 auto;">
        <div class="polaroid-media">
          <img src="https://img.improvlore.com/random?testimonials" alt="Community members at an improv show" eleventy:ignore loading="lazy" decoding="async" width="600" height="450">
        </div>
      </figure>
    </div>

    {# Two groups, shown as separate sub-walls. The non-cast (audience / student)
       voices lead: they read as the more independent, trustworthy word to
       someone deciding whether to come. A divider then introduces the cast's
       own words as the warmer insider view, tinted differently. Splitting is
       done here so the JSON stays a simple append-only list. #}
    {% set publicVoices = testimonials.items | rejectattr("cast", "equalto", "yes") | list %}
    {% set castVoices = testimonials.items | selectattr("cast", "equalto", "yes") | list %}

    {% macro twCard(t, isCast) %}
      <li class="tw-card{% if isCast %} tw-card--cast{% endif %}">
        <blockquote class="tw-quote">
          {# `story` may be a single string or a list of paragraph strings. Treat
             a string as a one-item list so both render as one <p> per paragraph. #}
          {% set paras = t.story if (t.story is iterable and t.story is not string) else [t.story] %}
          {% for para in paras %}
            {% if para | trim %}<p>{{ para | trim }}</p>{% endif %}
          {% endfor %}
        </blockquote>
        <div class="tw-attr">
          <p class="tw-name">{{ t.name }}</p>
          {% if t.subtitle %}<p class="tw-sub">{{ t.subtitle }}</p>{% endif %}
          {% if t.social %}
            {% set handle = t.social | replace("@", "") %}
            <a class="tw-social" href="https://instagram.com/{{ handle }}" target="_blank" rel="noopener">@{{ handle }}</a>
          {% endif %}
        </div>
      </li>
    {% endmacro %}

    {% if publicVoices | length %}
      <ul class="tw-grid" aria-label="Testimonials">
        {% for t in publicVoices %}{{ twCard(t, false) }}{% endfor %}
      </ul>
    {% endif %}

    {% if castVoices | length %}
      <div class="tw-divider" role="separator">
        <span class="tw-divider-label">From our cast</span>
      </div>
      <ul class="tw-grid tw-grid--cast" aria-label="Testimonials from our cast">
        {% for t in castVoices %}{{ twCard(t, true) }}{% endfor %}
      </ul>
    {% endif %}

    <div class="tw-cta">
      <p class="tw-cta-text">Done a show, jam, or workshop with us? We'd love to hear how it went.</p>
      <a class="btn btn-primary btn-lg" href="/fill-testimonial/">Leave a testimonial</a>
    </div>
  </section>
</div>
