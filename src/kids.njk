<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  // Mirrors contact.njk's submit flow: POST to /submit (Turnstile-verified),
  // which forwards entry.* fields to the Google Form set up for this "form"
  // key. Falls back to a prefilled WhatsApp message if /submit can't be
  // reached, so an enquiry is never silently lost.
  (function () {
    const form = document.querySelector(".contact-form");
    if (!form) return;
    const status = form.querySelector(".contact-status");
    const errorBox = form.querySelector(".contact-error");
    const button = form.querySelector('button[type="submit"]');
    const action = form.getAttribute("action");
    const FALLBACK_WHATSAPP = "{{ social.whatsappArjun | safe }}".split("?")[0];

    const resetTurnstile = () => {
      if (window.turnstile) {
        try { window.turnstile.reset(); } catch (e) {}
      }
    };

    const showError = (msg) => {
      if (!errorBox) return;
      errorBox.textContent = msg;
      errorBox.hidden = false;
    };
    const clearError = () => {
      if (errorBox) errorBox.hidden = true;
    };

    const readForm = () => ({
      parentName: (document.getElementById("kf-parent-name") || {}).value || "",
      whatsapp:   (document.getElementById("kf-whatsapp")    || {}).value || "",
      email:      (document.getElementById("kf-email")       || {}).value || "",
      childName:  (document.getElementById("kf-child-name")  || {}).value || "",
      childAge:   (document.getElementById("kf-child-age")   || {}).value || "",
      ideas:      (document.getElementById("kf-ideas")       || {}).value || "",
    });

    const whatsappFallback = (data) => {
      const lines = [
        "Hi Arjun, the Improvlore website couldn't reach the kids workshop form, so here's my info:",
        "",
        "Parent name: " + data.parentName,
        "WhatsApp: " + data.whatsapp,
        "Email: " + data.email,
        "Child's name: " + data.childName,
        "Child's age: " + data.childAge,
        "",
        "What would help: " + (data.ideas || "-"),
      ];
      const href = FALLBACK_WHATSAPP + "?text=" + encodeURIComponent(lines.join("\n"));
      window.location.href = href;
    };

    const showSent = () => {
      if (status) status.hidden = false;
      form.reset();
      resetTurnstile();
    };

    form.addEventListener("submit", async function (e) {
      e.preventDefault();
      clearError();
      if (!form.reportValidity()) return;

      const formData = new FormData(form);
      if (!formData.get("cf-turnstile-response")) {
        showError("Please complete the verification above, then send again.");
        return;
      }

      const data = readForm();
      if (button) {
        button.disabled = true;
        button.textContent = "Sending...";
      }

      try {
        const resp = await fetch(action, {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams(formData).toString(),
        });
        const result = await resp.json().catch(() => ({}));

        if (resp.ok && result.ok) {
          showSent();
        } else if (result.error === "turnstile_failed" || result.error === "missing_token") {
          showError("Verification failed. Please complete the check and try again.");
          resetTurnstile();
        } else {
          console.error("Kids form submit failed:", result);
          whatsappFallback(data);
          showSent();
        }
      } catch (err) {
        console.error("Kids form unreachable, using WhatsApp fallback:", err);
        whatsappFallback(data);
        showSent();
      } finally {
        if (button) {
          button.disabled = false;
          button.textContent = "Send & subscribe";
        }
      }
    });
  })();
</script>
