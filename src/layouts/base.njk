<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  {% set desc = pageDescription or "Improv Lore: Live improv theatre, jams, and workshops in Bangalore and beyond. No script, no second take, made up on the spot." %}
  <meta name="description" content="{{ desc }}">
  {% if robots %}<meta name="robots" content="{{ robots }}">{% endif %}
  <link rel="canonical" href="{{ site.absUrl(canonicalUrl or page.url) }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ desc }}">
  <meta property="og:url" content="{{ site.absUrl(page.url) }}">
  <meta property="og:site_name" content="{{ site.name }}">
  {% set ogImage = pageImage or "/assets/logo.png" %}
  <meta property="og:image" content="{{ site.absUrl(ogImage) }}">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="{% if pageImage %}summary_large_image{% else %}summary{% endif %}">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="alternate" type="application/atom+xml" title="Improvlore upcoming events" href="/feed.xml">
  {% if jsonLd %}<script type="application/ld+json">{{ jsonLd | safe }}</script>{% endif %}
  <style>
    {{ "src/assets/css/base.css" | inlineCss | safe }}
    {{ "src/assets/css/motifs.css" | inlineCss | safe }}
    {{ "src/assets/css/components.css" | inlineCss | safe }}
    {{ "src/assets/css/pages.css" | inlineCss | safe }}
  </style>
  {% if pageStyles %}{% for href in pageStyles %}<link rel="stylesheet" href="{{ href }}">{% endfor %}{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&display=swap" rel="stylesheet"></noscript>
</head>

<body>
  {# The full motif set. Each page shows only a rotating subset of these so the
     background doesn't read identically everywhere. The slice is derived from
     the page URL, so it's stable per page (no layout shift) but varies page to
     page. Index in this list maps to the motif-N positioning classes in CSS. #}
  {% set allMotifs = [
    "/assets/icons/lightning.png",
    "/assets/icons/starburst.png",
    "/assets/icons/star-purple.png",
    "/assets/icons/diamond.png",
    "/assets/icons/star-4point.png",
    "/assets/icons/moon.png",
    "/assets/icons/star-green.png",
    "/assets/icons/ring-pink.png",
    "/assets/icons/star-outline.png",
    "/assets/icons/arc-blue.png",
    "/assets/icons/arc-green.png",
    "/assets/icons/arc-pink.png",
    "/assets/icons/pacman-orange.png",
    "/assets/icons/pacman-yellow.png",
    "/assets/icons/blob-blue.png",
    "/assets/icons/blob-cream.png"
  ] %}
  {# Seed an offset from the URL length so each page starts the rotation at a
     different motif. Show 9 of the 16, wrapping around the end of the list. #}
  {% set motifSeed = (page.url | length) %}
  <div class="page-motifs" aria-hidden="true">
    {% for src in allMotifs %}
      {% set n = loop.index0 %}
      {% set shown = ((n - motifSeed) % 16 + 16) % 16 %}
      {% if shown < 9 %}
      <img class="motif motif-{{ loop.index }}" src="{{ src }}" alt="" loading="lazy" decoding="async" eleventy:ignore>
      {% endif %}
    {% endfor %}
  </div>

  {# Frosted pane sitting between the animated background motifs and the page
     content, so the shapes read as a soft, blurred wash rather than competing
     with text. #}
  <div class="page-frost" aria-hidden="true"></div>

  <div class="foreground-motifs" aria-hidden="true">
    <img class="fg-motif fg-motif-lightning" src="/assets/icons/lightning.png"     alt="" loading="lazy" decoding="async" eleventy:ignore>
    <img class="fg-motif fg-motif-pacman"    src="/assets/icons/pacman-yellow.png" alt="" loading="lazy" decoding="async" eleventy:ignore>
  </div>

  {# Top bar: logo left, nav right. Aria labels ensure screen readers understand structure. #}
  {# "Work With Us" is the single door for audience #2 (someone vetting us for a
     corporate or festival booking). It points at /for-teams/, which pitches both
     and links on to /festivals/ as the credibility proof. Festivals keeps its
     page and footer link, just not its own top-level nav slot. #}
  {# Library lives in the footer "Explore" nav, not the top bar, to keep the top
     nav lean. The footer link is the canonical entry point for it. #}
  {% set navLinks = [
    { url: "/", label: "Home" },
    { url: "/about/", label: "About" },
    { url: "/events/", label: "Upcoming" },
    { url: "/for-teams/", label: "Work With Us" },
    { url: "https://blog.improvlore.com", label: "Blog", external: true },
    { url: "/contact/", label: "Contact" }
  ] %}
  <header class="site-header" role="banner">
    <a class="site-header-logo" href="/" aria-label="Improv Lore home page">
      <img class="hero-logo" src="/assets/logo.png" alt="Improv Lore" width="245" height="36" eleventy:ignore>
    </a>
    {# On wide screens the links sit inline. Below the breakpoint the button
       shows and the nav collapses to a dropdown panel toggled by it. #}
    <button class="site-nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <span class="site-nav-toggle-bars" aria-hidden="true"></span>
    </button>
    <nav class="site-nav" id="site-nav" aria-label="Main navigation">
      {% for link in navLinks %}
      {% if link.external %}
      <a class="site-nav-link" href="{{ link.url }}" target="_blank" rel="noopener">{{ link.label }} ↗</a>
      {% else %}
      <a class="site-nav-link{% if page.url == link.url %} is-active{% endif %}" href="{{ link.url }}"{% if page.url == link.url %} aria-current="page"{% endif %}>{{ link.label }}</a>
      {% endif %}
      {% endfor %}
    </nav>
  </header>

  {# Announcement ticker. Shown on every page by default, except the homepage,
     the events list, and per-event pages (those already foreground upcoming
     events, so the ticker would be redundant there). Any page can still force
     it on/off with `showBanner: true/false` in its front matter. #}
  {% set bannerHidden = page.url == "/" or page.url == "/events/" or ("/event/" in page.url) %}
  {% if showBanner or (showBanner is undefined and not bannerHidden) %}
    {% include "banner.njk" %}
  {% endif %}

  <main>
    {{ content | safe }}
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-cols">
        <nav class="footer-col" aria-label="Explore">
          <h2 class="footer-col-title">Explore</h2>
          <a href="/">Home</a>
          <a href="/about/">About</a>
          <a href="/events/">Upcoming</a>
          <a href="/library/">Library</a>
          <a href="/faq/">FAQ</a>
          <a href="/for-teams/">Work With Us</a>
          <a href="/festivals/">Festivals</a>
          <a href="/contact/">Contact</a>
          <a href="https://blog.improvlore.com" target="_blank" rel="noopener">Blog ↗</a>
        </nav>

        <nav class="footer-col" aria-label="Legal">
          <h2 class="footer-col-title">Legal</h2>
          <a href="/code-of-conduct/">Code of Conduct</a>
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
          <a href="/refunds/">Refunds</a>
        </nav>
      </div>

      {# Social links, icon-only, sit with the copyright row at the foot. #}
      <div class="footer-socials" aria-label="Social links">
        <a class="footer-social" href="{{ social.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
          <img class="footer-social-icon" src="/assets/icons/instagram.svg" alt="" width="20" height="20" loading="lazy">
        </a>
        <a class="footer-social" href="{{ social.whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp Community">
          <img class="footer-social-icon" src="/assets/icons/whatsapp.svg" alt="" width="20" height="20" loading="lazy">
        </a>
        <a class="footer-social" href="{{ social.youtube }}" target="_blank" rel="noopener" aria-label="YouTube">
          <img class="footer-social-icon" src="/assets/icons/youtube.svg" alt="" width="20" height="20" loading="lazy">
        </a>
      </div>

      <div class="footer-legal">
        <p>&copy; {{ site.year }} Improvlore. All rights reserved.</p>
        <p>Based in Bangalore, India. Questions? <a href="/contact/">Contact us</a></p>
      </div>
    </div>
  </footer>

  <script>
    // Mobile nav: the hamburger toggles the dropdown panel. Keeps aria-expanded
    // in sync, closes on Escape, on click outside, and after a link is tapped.
    (function () {
      const toggle = document.querySelector(".site-nav-toggle");
      const nav = document.getElementById("site-nav");
      if (!toggle || !nav) return;

      const setOpen = (open) => {
        toggle.setAttribute("aria-expanded", open ? "true" : "false");
        toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        nav.classList.toggle("is-open", open);
      };

      toggle.addEventListener("click", function () {
        setOpen(toggle.getAttribute("aria-expanded") !== "true");
      });

      nav.addEventListener("click", function (e) {
        if (e.target.closest(".site-nav-link")) setOpen(false);
      });

      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") setOpen(false);
      });

      document.addEventListener("click", function (e) {
        if (toggle.getAttribute("aria-expanded") !== "true") return;
        if (!e.target.closest(".site-header")) setOpen(false);
      });
    })();
  </script>
  <script src="/assets/ticket-button.js" defer></script>
  <script src="/assets/shouts.js" defer></script>
</body>
</html>
