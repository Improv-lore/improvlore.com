---
layout: base.njk
title: Upcoming - Improvlore
permalink: /events/index.html
showCustomEvents: false
---
{% from "badges.njk" import posterBadges %}

<div class="events-root">

  <section class="page-section" aria-labelledby="section-whats-on">
    <h1 class="section-heading" id="section-whats-on">Upcoming</h1>
    <p class="section-sub">Every upcoming show, jam, and workshop in one place. Filter by type, or just browse.</p>

  <div class="event-key" role="group" aria-label="Filter events by type">
    <button type="button" class="event-key-item" data-filter="show" aria-pressed="false">
      <span class="event-key-dot dot-show"></span>
      <div>
        <strong>SHOW</strong>
        <p>You shape the show with us</p>
      </div>
    </button>
    <button type="button" class="event-key-item" data-filter="jam" aria-pressed="false">
      <span class="event-key-dot dot-jam"></span>
      <div>
        <strong>JAM</strong>
        <p>Come play with us, beginner friendly</p>
      </div>
    </button>
    <button type="button" class="event-key-item" data-filter="workshop" aria-pressed="false">
      <span class="event-key-dot dot-workshop"></span>
      <div>
        <strong>WORKSHOP</strong>
        <p>Learn to play, kind to first-timers</p>
      </div>
    </button>
    <button type="button" class="event-key-clear" data-filter-clear hidden aria-label="Clear filter">
      <span aria-hidden="true">×</span> Clear
    </button>
  </div>

  <div class="filter-empty" hidden>
    <h2>No <span class="filter-empty-type">events</span> coming up</h2>
    <p>Nothing of that kind on the calendar right now. Try the other type or clear the filter.</p>
  </div>

  {# One card. Shared across the time buckets below so the markup lives once. #}
  {% macro eventCard(ev) %}
    {# Prefers the self-hosted format poster, falls back to the feed image
       for genuine one-offs. See filters.eventImage. #}
    {% set img = filters.eventImage(ev) %}

    {% set evType = filters.eventType(ev.title, ev.tags) %}
    <div id="{{ filters.eventSlug(ev) }}" class="event-card event-type-{{ evType }}">

        {% if img %}
          <div class="event-image">
            <img src="{{ img }}" alt="{{ filters.workshopName(ev.title) }} poster" loading="lazy" sizes="(min-width: 640px) 50vw, 100vw">
          </div>
        {% endif %}

        <div class="event-card-body">
          <span class="event-type-badge">{{ evType }}</span>
          {{ posterBadges(filters.eventBadges(ev.title), evType, true) }}
          {# Title is a "stretched link": its ::before covers the whole card so a
             tap anywhere (except the buttons/venue link) opens the detail page.
             Especially helps on phones, where the big poster is the obvious tap
             target. The explicit buttons below sit above it and keep their own
             clicks. #}
          <h2 class="event-title"><a class="event-card-stretch" href="{{ filters.eventPermalink(ev) }}">{{ filters.workshopName(ev.title) }}</a></h2>

          {# The calendar tile already carries the date, so we don't repeat it as
             plain text; the detail column shows the time, then the venue
             underneath in a smaller font (and as the Maps link where we have
             one). Mirrors the per-event detail page. #}
          {% if ev.event_starts_at %}
            <div class="event-when">
              <span class="event-when-cal" aria-hidden="true">
                <span class="event-when-dow">{{ filters.formatDay(ev.event_starts_at) }}</span>
                <span class="event-when-day">{{ filters.formatDayNum(ev.event_starts_at) }}</span>
                <span class="event-when-mon">{{ filters.formatMonth(ev.event_starts_at) }}</span>
              </span>
              <span class="event-when-detail">
                <span class="event-when-time">{{ filters.formatTime(ev.event_starts_at) }}</span>
                {% if ev.venue %}
                  {% set mapUrl = filters.venueMapUrl(ev.venue) %}
                  {% if mapUrl %}
                    <a class="event-venue event-venue-link" href="{{ mapUrl }}" target="_blank" rel="noopener">{{ ev.venue }}</a>
                  {% else %}
                    <span class="event-venue">{{ ev.venue }}</span>
                  {% endif %}
                {% endif %}
              </span>
            </div>
          {% endif %}

          <p class="event-excerpt">
            {{ filters.cardText(ev.full_content or ev.excerpt, 260) }}
          </p>

          <div class="event-buttons">
            <a class="btn btn-primary"{% if "district.in" in ev.url %} data-ticket-slug{% endif %} href="{{ ev.url }}" target="_blank" rel="noopener">Buy Ticket</a>
            <a class="btn btn-ghost event-learn-more" href="{{ filters.eventPermalink(ev) }}" aria-label="Learn more about {{ filters.workshopName(ev.title) }}"><span aria-hidden="true">→</span></a>
          </div>
        </div>

    </div>
  {% endmacro %}

  {# Group events into time buckets in one pass (filters.bucketedEvents): it
     applies the UC/showCustom filter, drops past/undated events, and returns
     only the non-empty buckets in display order. The feed is already sorted by
     date, so each bucket stays in order. An empty list falls back to the
     empty-state below (feed empty between listings, or the fetch failed). #}
  {% set buckets = filters.bucketedEvents(events, showCustomEvents) %}

  {% if buckets | length > 0 %}
    {% for bucket in buckets %}
      <div class="event-bucket">
        <h2 class="event-bucket-heading">{{ bucket.label }}</h2>
        <div class="event-grid">
        {% for ev in bucket.events %}{{ eventCard(ev) }}{% endfor %}
        </div>
      </div>
    {% endfor %}
  {% else %}
    <div class="empty-state">
      <h2>Nothing on the calendar right now</h2>
      <p>No public dates this minute. Browse every show, jam, and workshop we run in <a href="/library/">the library</a>, read the <a href="/faq/">FAQ</a> if it's your first time, or join the WhatsApp group to catch the next drop.</p>
      <div class="event-buttons empty-state-cta">
        <a class="btn btn-primary contact-wa-btn" href="{{ social.whatsapp }}" target="_blank" rel="noopener">Join the WhatsApp group</a>
        <a class="btn btn-ghost" href="/library/">Browse the library</a>
      </div>
    </div>
  {% endif %}

  {% if buckets | length > 0 %}
  <p class="events-more">
    Looking past what's scheduled? Every show, jam, and workshop we run lives in
    <a href="/library/">the library →</a>
  </p>
  {% endif %}

  {# Standing prompt so visitors can subscribe to drops whether or not anything
     is listed right now. WhatsApp community is where new dates are announced. #}
  <a class="corporate-banner events-updates" href="{{ social.whatsapp }}" target="_blank" rel="noopener">
    <span class="corporate-banner-text">
      <strong>Get new dates first.</strong>
      Join the WhatsApp group for the latest shows, jams, and workshops.
    </span>
    <span class="corporate-banner-arrow" aria-hidden="true">→</span>
  </a>

  {# One download with every upcoming event, built from the same set shown
     above (see events-ics.11tydata.js). Only offered when there's something
     to add. #}
  {% if buckets | length > 0 %}
  <p class="events-add-all">
    <a class="btn btn-ghost events-add-all-btn" href="/events.ics" download>
      <img src="/assets/calendar-heart.svg" alt="" width="20" height="20" loading="lazy">
      Add all to calendar
    </a>
  </p>
  {% endif %}

  </section>

</div>

<script>
  // Keep the URL's ?type= in sync with the visible filter, using
  // replaceState so changing/clearing a filter never adds a history entry.
  const syncFilterUrl = (filter) => {
    const url = new URL(window.location.href);
    if (filter) {
      url.searchParams.set("type", filter);
    } else {
      url.searchParams.delete("type");
    }
    history.replaceState(history.state, "", url);
  };

  const applyFilter = (filter, syncUrl = true) => {
    const root = document.querySelector(".events-root");
    if (!root) return;
    root.querySelectorAll(".event-key-item[data-filter]").forEach((b) => {
      b.setAttribute("aria-pressed", b.dataset.filter === filter ? "true" : "false");
    });
    root.classList.remove("filter-show", "filter-jam", "filter-workshop");
    const clearBtn = root.querySelector("[data-filter-clear]");
    const empty = root.querySelector(".filter-empty");
    if (filter) {
      root.classList.add("filter-" + filter);
      if (clearBtn) clearBtn.hidden = false;
      if (empty) {
        const visibleCards = root.querySelectorAll(
          ".event-card.event-type-" + filter
        ).length;
        empty.hidden = visibleCards > 0;
        const label = empty.querySelector(".filter-empty-type");
        if (label) label.textContent = filter + "s";
      }
    } else {
      if (clearBtn) clearBtn.hidden = true;
      if (empty) empty.hidden = true;
    }
    if (syncUrl) syncFilterUrl(filter);
  };

  document.addEventListener("click", (e) => {
    if (e.target.closest("[data-filter-clear]")) {
      applyFilter(null);
      return;
    }
    const btn = e.target.closest(".event-key-item[data-filter]");
    if (!btn) return;
    const isActive = btn.getAttribute("aria-pressed") === "true";
    applyFilter(isActive ? null : btn.dataset.filter);
  });

  // Preselect a filter from ?type= so links like /events/?type=workshop land
  // on the events page with that type already filtered.
  const initialType = new URLSearchParams(window.location.search).get("type");
  if (initialType && ["show", "jam", "workshop"].includes(initialType)) {
    applyFilter(initialType, false);
  }
</script>
