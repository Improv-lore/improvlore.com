---
layout: base.njk
pageStyles:
  - /assets/css/event-detail.css
---

{% set evType = filters.eventType(ev.title, ev.tags) %}

{% set bodyText = ev.full_content or ev.excerpt or "" %}
{% set d = {
  type: evType,
  slug: (filters.matchFormat(ev.title) and filters.matchFormat(ev.title).slug) or ev.slug or "",
  image: filters.eventImage(ev),
  title: ev.title,
  hasWhen: ev.event_starts_at,
  startsRaw: ev.event_starts_at,
  startsAt: filters.formatDateFull(ev.event_starts_at),
  timeRange: filters.formatTimeRange(ev.event_starts_at, ev.event_ends_at),
  venue: ev.venue,
  bodyParas: filters.bodyParagraphs(bodyText),
  ticketUrl: ev.url,
  isMarathon: ev.isMarathon,
  thumpnUrl: ev.thumpnUrl,
  districtUrl: ev.districtUrl,
  learnMore: ev.learn_more
} %}

{% include "event-detail.njk" %}
