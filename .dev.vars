# Local-only env vars for `wrangler pages dev` (Pages Functions runtime).
# Git-ignored. Cloudflare's published Turnstile TESTING secret: always
# verifies as a pass, paired with the TURNSTILE_SITE_KEY testing sitekey in
# .env. Never use in production -- set the real TURNSTILE_SECRET_KEY as a
# Pages environment variable in the Cloudflare dashboard instead.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
